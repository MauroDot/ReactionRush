<!--
    Same original 108-unit mark as rr_pulse_mark, rendered into the platform's
    288dp icon canvas without an icon background. Visible artwork is 156dp across,
    safely inside Android 12+'s central 192dp circle. The mandated platform canvas
    intentionally exceeds the general-purpose 200dp vector recommendation.
    Static vector; no launch delay.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="VectorRaster"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/rr_cyan"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:pathData="M79.96,46.56 A27,27 0,0 0,28.04 46.56 M28.04,61.44 A27,27 0,0 0,79.96 61.44" />
    <path
        android:fillColor="@color/rr_mint"
        android:pathData="M60.5,30 L40.5,57 L52,57 L47,78 L68.5,49 L57,49 Z" />
</vector>
